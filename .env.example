# Web scraping: https://anakin.io (free tier works)
ANAKIN_API_KEY=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Comma-separated list, tried in order.
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.8-flash

# Optional. Public address of the deployed site, used for link previews.
# SITE_URL=https://example.vercel.app

# Optional. Set by Vercel when a Blob store is connected. Without it, briefs are written to ./.data
# BLOB_READ_WRITE_TOKEN=

# Optional limits on fresh scans (they cost scraping credits).
# SCANS_PER_DAY=40
# SCANS_PER_VISITOR=5
